+// --draft-k auto (R3.3.7): the width of each round follows the turn's running
+// acceptance. The verify walk is unchanged, so the stream is plain decoding's
+// whatever width a round takes; only the cost of a round moves.
+//
+// Per round the drafts accepted before the first rejection are a run of
+// successes, so a round of nd drafts with acc accepted adds acc successes and,
+// when acc < nd, one failure. Both decay by SPEC_AUTO_DECAY a round (drafted
+// or not), so a turn that changes register (code to prose) moves the estimate
+// within a few rounds, and a width of 0 drifts back to the source's prior and
+// tries again. With p the per-token acceptance, a width K returns
+// 1 + p + ... + p^K tokens for c(K) + K * draft plain steps, c(K) the verify
+// cost of K + 1 rows; the round takes the K with the most tokens a step.
+//
+// c(K) per backend, measured (suite plan R3.3.7): CUDA from SS-001 R1 (a row
+// costs about 0.2 of a step up to eight rows, and the ninth jumps, so 7 is the
+// last width); the CPU from SS-000 row 1 (0.45 to 0.78 of a step a row, so 4).
+// Metal pays K + 1 steps for K + 1 rows (no verify twins until R3.3.9), so
+// auto does not speculate there. A NextN head is capped at 4 (SS-002: K 7 was
+// slower than plain at every measured acceptance on the 4B class).
+enum { SPEC_AUTO_KMAX = 7 };
+#define SPEC_AUTO_DECAY 0.8
+#define SPEC_AUTO_PRIOR_W 2.0
+static const double spec_cost_cuda[SPEC_AUTO_KMAX + 1] =
+    {1.00, 1.44, 1.61, 1.77, 1.92, 2.14, 2.35, 2.57};
+static const double spec_cost_cpu[SPEC_AUTO_KMAX + 1] =
+    {1.00, 1.56, 2.09, 2.62, 3.15, 0, 0, 0};
+
+typedef struct {
+    const double *cost;
+    int    kmax;       // 0: auto never drafts on this backend
+    double draft;      // plain steps a drafted token costs
+    double prior;      // per-token acceptance before the turn has any
+    double s, f;       // decayed successes and failures
+    int    hist[SPEC_AUTO_KMAX + 1];   // rounds per chosen width
+} spec_auto;
+
+static void spec_auto_init(spec_auto *a, const engine *e, int kcap) {
+    memset(a, 0, sizeof(*a));
+    const model_t *m = e->m;
+    const char *be = model_backend_name(m);
+    if (!strcmp(be, "cuda")) { a->cost = spec_cost_cuda; a->kmax = 7; }
+    else if (!strcmp(be, "cpu")) { a->cost = spec_cost_cpu; a->kmax = 4; }
+    else { a->cost = spec_cost_cuda; a->kmax = 0; }
+    if (e->mtp_on) {
+        if (a->kmax > 4) a->kmax = 4;
+        a->draft = m->gpu ? 0.23 : 0.16;   // SS-001 R2; the 10-31 CPU profile
+        a->prior = 0.7;
+    } else if (e->dm) {
+        // a draft forward is a weight pass of the draft file
+        a->draft = e->dm->file_id_ok && m->file_id_ok && m->file_size
+                 ? (double)e->dm->file_size / (double)m->file_size : 0.3;
+        a->prior = 0.7;
+    } else {
+        a->draft = 0;      // lookup: an integer search
+        a->prior = 0.9;
+    }
+    if (a->kmax > kcap) a->kmax = kcap;
+}
+
+static int spec_auto_width(spec_auto *a) {
+    double p = (a->s + SPEC_AUTO_PRIOR_W * a->prior) / (a->s + a->f + SPEC_AUTO_PRIOR_W);
+    int best = 0;
+    double best_r = 1.0, t = 1.0, pk = 1.0;
+    for (int k = 1; k <= a->kmax; k++) {
+        pk *= p;
+        t += pk;
+        double r = t / (a->cost[k] + k * a->draft);
+        if (r > best_r) { best_r = r; best = k; }
+    }
+    a->hist[best]++;
+    return best;
+}
+
+// a round's outcome; nd == 0 (a width of 0, or lookup found nothing) only ages
+// the evidence
+static void spec_auto_note(spec_auto *a, int nd, int acc) {
+    a->s *= SPEC_AUTO_DECAY;
+    a->f *= SPEC_AUTO_DECAY;
+    if (nd <= 0) return;
+    a->s += acc;
+    if (acc < nd) a->f += 1;
+}
